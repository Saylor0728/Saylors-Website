/* scratch-style.css */

body {
    background-color: #f0f8ff;
    font-family: Arial, sans-serif;
    color: #333;
    margin: 0;
    padding: 0;
}

header {
    background-color: #0077cc;
    color: white;
    text-align: center;
    padding: 20px;
}

section {
    margin: 20px;
    padding: 20px;
    background-color: #e6f2ff;
    border-radius: 8px;
}

/* Div example styles */
.div1, .div2, .div3 {
    margin: 10px;
    padding: 15px;
    background-color: #d1e7dd;
    border: 1px solid #a3c4b3;
}

/* Extra for links */
a {
    color: #0077cc;
    text-decoration: none;
}
a:hover {
    text-decoration: underline;
}
